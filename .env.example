# =============================================================================
# VedaAI Exam Evaluator - Environment Variables Example
# =============================================================================
# Copy this file to .env.local and populate your Google Gemini API Key.
# In Vercel, configure these variables in Settings -> Environment Variables.

# Google Gemini API Key (Server-side only; never exposed to the client bundle)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override primary model (Defaults to gemini-2.5-flash)
# Options: gemini-2.5-flash, gemini-2.5-flash-lite, gemini-flash-latest
GEMINI_MODEL=gemini-2.5-flash
